@@ -30,7 +30,24 @@ If you have questions concerning this license or the applicable additional terms
 #include "renderer/VertexCache.h"
 #include "renderer/Cinematic.h"
 
+#include <stdio.h>
+#include <stdlib.h>
 #include "renderer/tr_local.h"
+/* #214 state dump: shared with the standalone probe (Tests/userspace/gl_state_dump.h in the kext repo) */
+#ifndef GL_TEXTURE_RECTANGLE_EXT
+#define GL_TEXTURE_RECTANGLE_EXT 0x84F5
