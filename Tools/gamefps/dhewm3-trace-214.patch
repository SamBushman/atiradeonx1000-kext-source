+static void (APIENTRY *d3t_getAttribiv)( GLuint, GLenum, GLint * ) = NULL;
+#define GSD_ISEN(c) qglIsEnabled( c )
+#define GSD_GETI(p, a) qglGetIntegerv( p, a )
+#define GSD_GETF(p, a) qglGetFloatv( p, a )
+#define GSD_GETIV_ATTRIB(i, p, out) do { if ( !d3t_getAttribiv ) d3t_getAttribiv = (void (APIENTRY *)( GLuint, GLenum, GLint * ))GLimp_ExtensionPointer( "glGetVertexAttribivARB" ); if ( d3t_getAttribiv ) d3t_getAttribiv( i, p, out ); } while ( 0 )
+#define GSD_CLIENTACTIVE(u) qglClientActiveTextureARB( GL_TEXTURE0_ARB + (u) )
+#define GSD_ACTIVETEX(u) qglActiveTextureARB( GL_TEXTURE0_ARB + (u) )
+#define GSD_TEXLEVEL(t, l, p, o) qglGetTexLevelParameteriv( t, l, p, o )
